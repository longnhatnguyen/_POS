<ui:FluentWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" 
        x:Class="POS.MainWindow"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SmartPOS - Bảng Điều Khiển" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="SmartPOS Enterprise WPF UI" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Điều hướng bằng NavigationView xịn của Lepoco -->
            <ui:NavigationView Grid.Column="0" x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed">
                <ui:NavigationView.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,24,0">
                        <ui:Badge Appearance="Success" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Online Lõi" FontSize="14" FontWeight="Bold"/>
                        </ui:Badge>
                        <TextBlock Text="👤 Thu ngân: Admin VIP" Foreground="{StaticResource Text.Primary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:NavigationView.Header>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="TỔNG QUAN" Icon="{ui:SymbolIcon Home24}" x:Name="navDashboard" Click="navDashboard_Click"/>
                    <ui:NavigationViewItem Content="BÁN HÀNG LẺ (F12)" Icon="{ui:SymbolIcon Cart24}" />
                    <ui:NavigationViewItem Content="KHO VẬT TƯ" Icon="{ui:SymbolIcon Box24}" x:Name="navInventory" Click="navInventory_Click"/>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="THIẾT LẬP" Icon="{ui:SymbolIcon Settings24}" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- CONTENT KHU VỰC ĐỘNG -->
            <Grid Grid.Column="1" Margin="24">
                <!-- DASHBOARD CHÍNH -->
                <Grid x:Name="DashboardContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,40">
                        <ui:TextBlock Text="Đột Phá Doanh Thu Hôm Nay!" FontTypography="TitleLarge" Foreground="{StaticResource Brand.Primary}" Margin="0,0,0,8"/>
                        <ui:TextBlock Text="Các chỉ số theo real-time. Đóng ca cần xác thực vân tay." FontTypography="Body" Foreground="{StaticResource Text.Muted}"/>
                    </StackPanel>

                    <!-- Thẻ Tổng quan -->
                    <Grid Grid.Row="1" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1 -->
                        <ui:Card Grid.Column="0" Margin="0,0,12,0" Padding="24" ContextMenuService.IsEnabled="False">
                            <StackPanel>
                                <ui:TextBlock Text="💰 TỔNG DOANH THU" FontTypography="Caption" Foreground="{StaticResource Text.Muted}"/>
                                <ui:TextBlock Text="12,500,000 đ" FontTypography="TitleLarge" Foreground="{StaticResource Status.Success}" Margin="0,12,0,0"/>
                                <ui:TextBlock Text="+15% so với hôm qua" FontTypography="Caption" Foreground="{StaticResource Brand.Primary}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Card 2 -->
                        <ui:Card Grid.Column="1" Margin="12,0" Padding="24">
                            <StackPanel>
                                <ui:TextBlock Text="📦 BIẾN ĐỘNG KHO" FontTypography="Caption" Foreground="{StaticResource Text.Muted}"/>
                                <ui:TextBlock Text="142 Mục" FontTypography="TitleLarge" Foreground="{StaticResource Brand.Primary}" Margin="0,12,0,0"/>
                                <ui:TextBlock Text="3 mã sắp hết hàng (Cần nhập)" FontTypography="Caption" Foreground="{StaticResource Status.Warning}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Card 3 -->
                        <ui:Card Grid.Column="2" Margin="12,0,0,0" Padding="24">
                            <StackPanel>
                                <ui:TextBlock Text="⏳ CẢNH BÁO / TREO CA" FontTypography="Caption" Foreground="{StaticResource Text.Muted}"/>
                                <ui:TextBlock Text="0 Lỗi" FontTypography="TitleLarge" Foreground="{StaticResource Text.Muted}" Margin="0,12,0,0"/>
                                <ui:TextBlock Text="Hệ thống trơn tru" FontTypography="Caption" Foreground="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>

                <!-- VÙNG RENDER CONTENT CHỈ ĐỊNH (KHO HÀNG) -->
                <ContentControl x:Name="DynamicContent" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
