<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="POS.MainWindow"
        Title="SmartPOS - Bảng Điều Khiển" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E"
        FontFamily="Segoe UI">

    <!-- Chia màn hình ra làm 3 phần: Sidebar, Header, Body -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#FF181825" BorderThickness="0,0,1,0" BorderBrush="#FF313244">
            <StackPanel Margin="0,20,0,0">
                <!-- Logo -->
                <TextBlock Text="SmartPOS" Foreground="#FF89B4FA" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- Menu Buttons -->
                <Button x:Name="btnDashboard" Content="🏠 Tổng Quan" Height="50" Background="#FF313244" Foreground="White" BorderThickness="0" FontSize="16" HorizontalContentAlignment="Left" Padding="20,0,0,0" Margin="10,5" Click="btnDashboard_Click"/>
                <Button x:Name="btnSale" Content="🛒 Bán Hàng (F12)" Height="50" Background="Transparent" Foreground="#FFA6ADC8" BorderThickness="0" FontSize="16" HorizontalContentAlignment="Left" Padding="20,0,0,0" Margin="10,5"/>
                <Button x:Name="btnInventory" Content="📦 Quản Lý Kho" Height="50" Background="Transparent" Foreground="#FFA6ADC8" BorderThickness="0" FontSize="16" HorizontalContentAlignment="Left" Padding="20,0,0,0" Margin="10,5" Click="btnInventory_Click"/>
                <Button x:Name="btnSettings" Content="⚙️ Cài Đặt" Height="50" Background="Transparent" Foreground="#FFA6ADC8" BorderThickness="0" FontSize="16" HorizontalContentAlignment="Left" Padding="20,0,0,0" Margin="10,5"/>
            </StackPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Dashboard Content -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#FF1E1E2E" BorderThickness="0,0,0,1" BorderBrush="#FF313244" Padding="30,0">
                <Grid>
                    <TextBlock Text="Tổng Quan Hệ Thống" Foreground="White" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Trạng thái: " Foreground="#FFA6ADC8" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="⚫ Offline Mode" Foreground="#FFA6E3A1" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="👤 Thu ngân: Admin" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DASHBOARD CONTENT -->
            <Grid x:Name="DashboardContent" Grid.Row="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Welcome Text -->
                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock Text="Chào mừng đến với SmartPOS Enterprise!" Foreground="#FF89B4FA" FontSize="36" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Hệ thống đã sẵn sàng. Hãy chọn chức năng bên trái để bắt đầu phiên làm việc." Foreground="#FFA6ADC8" FontSize="18"/>
                </StackPanel>

                <!-- Quick Stats Cards (Giả lập Intro) -->
                <UniformGrid Grid.Row="1" Columns="3" Rows="1" VerticalAlignment="Top" Height="200">
                    <!-- Thuộc tính góc bo tròn bằng Border -->
                    <Border Background="#FF313244" CornerRadius="12" Margin="0,0,20,0" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="💰 Doanh Thu Hôm Nay" Foreground="#FFA6ADC8" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="0 đ" Foreground="#FFA6E3A1" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                            <TextBlock Text="Vừa kết ca" Foreground="#FFF38BA8" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FF313244" CornerRadius="12" Margin="10,0" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📦 Số Lượng Tồn Kho" Foreground="#FFA6ADC8" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="0 Mục" Foreground="#FF89B4FA" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                            <TextBlock Text="Chưa đồng bộ" Foreground="#FFF9E2AF" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FF313244" CornerRadius="12" Margin="20,0,0,0" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⏳ Hóa Đơn Trạng thái" Foreground="#FFA6ADC8" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="0 Treo" Foreground="#FFF38BA8" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                            <TextBlock Text="Không có giao dịch đang chờ" Foreground="#FFA6ADC8" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
            
            <!-- Vùng chứa màn hình động -->
            <ContentControl x:Name="DynamicContent" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
