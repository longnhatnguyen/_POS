<Window x:Class="POS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập Hệ Thống" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Border CornerRadius="12" Background="#FF1E1E2E" BorderBrush="#FF313244" BorderThickness="1">
        <StackPanel Margin="30" VerticalAlignment="Center">
            
            <TextBlock Text="SmartPOS" Foreground="#FF89B4FA" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Đăng nhập để vào ca làm việc" Foreground="#FFA6ADC8" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,40"/>

            <!-- Error message block -->
            <TextBlock x:Name="txtError" Foreground="#FFF38BA8" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- Input Username -->
            <TextBlock Text="Tên đăng nhập" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Height="40" Background="#FF313244" Foreground="White" BorderThickness="0" FontSize="16" Padding="10,8" Margin="0,0,0,20"/>

            <!-- Password -->
            <TextBlock Text="Mật khẩu" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="40" Background="#FF313244" Foreground="White" BorderThickness="0" FontSize="16" Padding="10,8" Margin="0,0,0,30"/>

            <!-- Login Button (IsDefault="True" để bắt phím Enter) -->
            <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" IsDefault="True" Height="50" Background="#FF89B4FA" Foreground="#FF11111B" FontSize="18" FontWeight="Bold" Cursor="Hand" Click="btnLogin_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <!-- (IsCancel="True" để bắt phím ESC) -->
            <Button x:Name="btnExit" Content="Thoát phần mềm" IsCancel="True" Background="Transparent" Foreground="#FFA6ADC8" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0" Click="btnExit_Click"/>

        </StackPanel>
    </Border>
</Window>
