<ui:FluentWindow x:Class="POS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Đăng Nhập Hệ Thống" Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        KeyDown="Window_KeyDown">

    <Grid>
        <ui:TitleBar Title="SmartPOS" Grid.Row="0"/>

        <!-- Khối Card Bo tròn nổi lên với DropShadow -->
        <ui:Card Margin="15,40,15,15" VerticalAlignment="Center">
            <!-- Vùng Padding Bọc Nội Dung -->
            <StackPanel Margin="16" VerticalAlignment="Center">
                
                <ui:TextBlock Text="SmartPOS" FontTypography="Title" Foreground="{StaticResource Brand.Primary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ui:TextBlock Text="Đăng nhập để vào ca làm việc" FontTypography="Body" Foreground="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Cảnh báo lỗi -->
                <ui:TextBlock x:Name="txtError" Foreground="{StaticResource Status.Error}" FontTypography="BodyStrong" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed"/>

                <ui:TextBlock Text="Tên đăng nhập" Margin="0,0,0,8"/>
                <ui:TextBox x:Name="txtUsername" PlaceholderText="Nhập tài khoản thu ngân" Margin="0,0,0,24"/>

                <ui:TextBlock Text="Mật khẩu" Margin="0,0,0,8"/>
                <ui:PasswordBox x:Name="txtPassword" PlaceholderText="Nhập mật khẩu" Margin="0,0,0,32"/>

                <ui:Button x:Name="btnLogin" Content="ĐĂNG NHẬP" Appearance="Primary" IsDefault="True" Click="btnLogin_Click" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>
                <ui:Button x:Name="btnExit" Content="Thoát phần mềm" Appearance="Secondary" IsCancel="True" Click="btnExit_Click" HorizontalAlignment="Stretch"/>

            </StackPanel>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
