<UserControl x:Class="POS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:POS.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FF1E1E2E"
             FontFamily="Segoe UI"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="720" d:DesignWidth="1030">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề & Tìm kiếm -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Quản Lý Kho Vật Tư" Foreground="White" FontSize="28" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="321,-1,0,1" Width="669">

                <TextBlock Text="Tìm kiếm:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="381" Height="40" Background="#FF313244" Foreground="White" BorderThickness="0" Padding="10,8" FontSize="16"/>
            </StackPanel>
        </Grid>
        <Button Content="+ Thêm Sản Phẩm Mới" Command="{Binding CreateProductCommand}" Background="#FF89B4FA" Foreground="#FF11111B" FontSize="14" FontWeight="Bold" BorderThickness="0" Padding="10,0" Cursor="Hand" Margin="784,0,6,20">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- Lưới dữ liệu (DataGrid) -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True" 
                  Background="#FF181825" RowBackground="#FF1E1E2E" AlternatingRowBackground="#FF313244"
                  Foreground="#FFA6ADC8" RowHeight="50" ColumnHeaderHeight="40"
                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None">

            <DataGrid.Resources>
                <!-- Style cho DataGrid Header -->
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#FF11111B"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100"/>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="150"/>
                <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Danh Mục" Binding="{Binding Category.Name}" Width="150"/>
                <DataGridTextColumn Header="Giá Bán" Binding="{Binding BasePrice, StringFormat=\{0:N0\} đ}" Width="120"/>

                <!-- CỘT TỒN KHO LÀ BẤT KHẢ XÂM PHẠM -->
                <DataGridTextColumn Header="Tồn Kho" Binding="{Binding StockQuantity}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#FFA6E3A1"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Cột hành động Cân Kho -->
                <DataGridTemplateColumn Header="Nghiệp vụ (Atomic)" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="+ Nhập sỉ (10 SP)1" Background="#FFF9E2AF" Foreground="Black" FontWeight="Bold" 
                                    BorderThickness="0" Margin="5" Cursor="Hand"
                                    Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>